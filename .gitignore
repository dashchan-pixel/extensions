# 1. Ignore everything in root by default (allowlist approach)
/*

# 2. Allow specific root configuration and documentation files
!/.gitignore
!/.github/
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/chan.properties
!/COPYING
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/build.sh
!/.editorconfig
!/detekt.yml
!/detekt-doublebang.yml
!/scripts/
!/metadata/
!/update/
!/gradlew
!/gradlew.bat
!/gradle/

# 3. Allow top-level project directories
!/build-logic/
!/chans/
!/engines/
!/sdk/

# 4. Ignore build artifacts and cache within allowed directories
**/build/
**/.gradle/
*.apk
*.aar
*.ap_
*.dex
*.class
