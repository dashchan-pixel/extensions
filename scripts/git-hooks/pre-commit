#!/usr/bin/env bash
#
# Pre-commit quality gate.
#
# Runs the same checks CI should, so bad code cannot reach a commit:
#
#   compileDebugKotlin  -- allWarningsAsErrors + -progressive: any warning is an error
#   ktlintCheck         -- formatting, incl. the trailing commas that keep diffs small
#   detekt              -- strict rules (empty catches, swallowed exceptions, etc.)
#
#   detektDoubleBang is wired into `check` and reports '!!' advisory-only (never fails).
#
# This is a multi-module build, so the hook detects which modules have staged changes
# and runs quality tasks only on those modules. A change in sdk/ or build-logic/
# triggers a full build because every module depends on them.
#
# Only runs when Kotlin/Gradle files are actually staged -- a docs- or resource-only
# commit should not pay for a Gradle run.
#
# Escape hatches:
#   git commit --no-verify     skip entirely (use sparingly)
#   SKIP_GRADLE_HOOK=1 git ...  same, but explicit about why
#
# Enable in a fresh clone (hooks are not cloned by git):
#   git config core.hooksPath scripts/git-hooks

set -uo pipefail

if [ "${SKIP_GRADLE_HOOK:-0}" = "1" ]; then
    echo "pre-commit: skipped (SKIP_GRADLE_HOOK=1)"
    exit 0
fi

# Only consider files staged for this commit (Added/Copied/Modified/Renamed).
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts' 2>/dev/null)
if [ -z "$staged" ]; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

file_count=$(echo "$staged" | wc -l | tr -d ' ')

# Determine which Gradle tasks to run.
# If shared infrastructure changed (sdk/, build-logic/, root files), run everything.
# Otherwise, run only the affected modules.
tasks=()
if echo "$staged" | grep -qE '^(sdk/|build-logic/|build\.gradle\.kts|settings\.gradle\.kts|detekt\.yml|detekt-doublebang\.yml|\.editorconfig)'; then
    # Shared infrastructure changed — full quality check.
    tasks+=(compileDebugKotlin ktlintCheck detekt)
else
    # Collect affected modules.
    modules=()
    while IFS= read -r file; do
        # Match chans/<module>/... or engines/<module>/...
        if [[ "$file" =~ ^(chans|engines)/([^/]+)/ ]]; then
            mod=":${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
            # Deduplicate.
            if [[ ! " ${modules[*]:-} " =~ " $mod " ]]; then
                modules+=("$mod")
            fi
        fi
    done <<< "$staged"

    if [ ${#modules[@]} -eq 0 ]; then
        # Staged .kt/.kts files don't map to a known module — run everything.
        tasks+=(compileDebugKotlin ktlintCheck detekt)
    else
        for mod in "${modules[@]}"; do
            tasks+=("${mod}:compileDebugKotlin" "${mod}:ktlintCheck" "${mod}:detekt")
        done
    fi
fi

echo "pre-commit: $file_count Kotlin file(s) staged — running quality gate..."

# --quiet keeps the hook readable; failures still print their own diagnostics.
if ! ./gradlew --quiet "${tasks[@]}"; then
    cat >&2 <<'EOF'

pre-commit: FAILED — commit aborted.

  Formatting problems?      ./gradlew ktlintFormat   (auto-fixes most of them)
  Warning treated as error?  allWarningsAsErrors is on; fix the warning, do not suppress it.
  detekt finding?            New code must not add empty catches, swallowed exceptions,
                             or over-long methods. Existing legacy findings are frozen in
                             per-module detekt-baseline.xml files — do NOT regenerate a
                             baseline just to make a new finding disappear.

  Genuinely need to bypass:  git commit --no-verify
EOF
    exit 1
fi

echo "pre-commit: OK"
exit 0
